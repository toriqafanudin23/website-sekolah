# Salin menjadi .env untuk pengembangan lokal. Di Vercel, isi lewat Project Settings > Environment Variables.
NODE_ENV=development
PORT=3001

# Dari Supabase: Project Settings > API Keys
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Kunci publishable (sb_publishable_...) atau kunci anon lama
SUPABASE_ANON_KEY=
# RAHASIA: kunci secret (sb_secret_...) atau service_role lama. Hanya di server; jangan pernah masuk frontend atau repositori.
SUPABASE_SERVICE_ROLE_KEY=

# Alamat frontend yang boleh memanggil API (pisahkan koma). Wajib untuk permintaan yang mengubah data.
ALLOWED_ORIGINS=http://localhost:5173

# Lax cocok bila frontend meneruskan /api lewat rewrite (satu domain). Pakai none hanya bila lintas domain.
COOKIE_SAMESITE=lax

# true = pendaftaran PPDB hanya diterima dalam rentang tanggal periode. Matikan (false) untuk uji coba.
ADMISSION_ENFORCE_DATES=true
