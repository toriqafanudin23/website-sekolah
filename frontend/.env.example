# Frontend (Vite). Salin menjadi .env.local untuk pengembangan.
# Alamat dasar API. Pakai /api (proxy lokal ke API di port 3001: lihat vite.config.ts; produksi: rewrite di vercel.json).
# Kosongkan untuk menjalankan tanpa backend (mode demo).
VITE_API_URL=/api

# Produksi: matikan login demo admin.
# VITE_ADMIN_DEMO=false
